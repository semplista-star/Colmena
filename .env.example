# --- Núcleo IA (imprescindible desde ya) ---
ANTHROPIC_API_KEY=
# DATABASE_URL = conexión POOLED de Supabase (puerto 6543, modo "Transaction"). La usa la app en producción.
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true&connection_limit=1
# DIRECT_URL = conexión DIRECTA de Supabase (puerto 5432, modo "Session"). Solo la usan las migraciones.
DIRECT_URL=postgresql://user:password@host:5432/postgres
APP_URL=http://localhost:3000

# --- Facturación de la licencia (Fase: cobro) ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_ANNUAL=        # price_xxx del plan 3000€/año
STRIPE_PRICE_SEMIANNUAL=    # price_xxx del plan 1500€/6 meses
STRIPE_WEBHOOK_SECRET=      # whsec_xxx, de Stripe Dashboard -> Developers -> Webhooks -> tu endpoint

# --- Envío de emails (Fase 3) ---
RESEND_API_KEY=

# --- Datos B2B / enriquecimiento de leads (AG-04) ---
APOLLO_API_KEY=

# --- Anuncios (AG-11 / AG-12) ---
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AD_ACCOUNT_ID=

# --- Agenda (AG-10) ---
CALCOM_API_KEY=

# --- SEM (AG-22) ---
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

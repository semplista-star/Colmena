// Esquema base para Colmena
// Migraciones (una vez, o cuando cambie el schema): npx prisma migrate deploy
// Requiere DATABASE_URL (pooled, puerto 6543) y DIRECT_URL (directa, puerto 5432)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (pgbouncer, puerto 6543) — usada en runtime
  directUrl = env("DIRECT_URL")   // conexión directa (puerto 5432) — usada solo para migraciones
}

model Client {
  id     String  @id @default(cuid())
  // domain es opcional: en el checkout de Stripe solo tenemos el email; el
  // dominio se rellena después en /onboarding (AG-01/AG-02 vía analyze-website).
  domain String? @unique

  companyName String?
  description String?
  icpProfile  Json? // perfil ICP generado por IA: {segments: [...], reasoning: "..."}

  // Licencia (rellenado por /api/billing/webhook al confirmar el pago en Stripe)
  email            String?   @unique
  licenseActive    Boolean   @default(false)
  licensePlan      String? // "annual" | "semiannual"
  licenseExpiresAt DateTime?
  stripeCustomerId String?
  stripeSessionId  String?

  createdAt DateTime   @default(now())
  campaigns Campaign[]
}

model Campaign {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  name        String   // ej: "Event designers"
  status      String   @default("draft") // draft | scaling | working | paused
  fitScore    Float?
  costPerLead Float?
  leads       Lead[]
  createdAt   DateTime @default(now())
}

model Lead {
  id           String   @id @default(cuid())
  campaignId   String
  campaign     Campaign @relation(fields: [campaignId], references: [id])
  fullName     String
  role         String?
  companyName  String?
  email        String
  fitScore     Float?
  status       String   @default("new") // new | emailed | replied | booked | rejected
  emailLogs    EmailLog[]
  createdAt    DateTime @default(now())
}

model EmailLog {
  id         String   @id @default(cuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id])
  direction  String   // outbound | inbound
  subject    String?
  body       String
  sentAt     DateTime @default(now())
}
